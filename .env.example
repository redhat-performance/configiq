# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AISimulators API gateway — used by the app/api/ proxy routes (server-side).
# Powers /api/recommend, /api/estimate, /api/memory, /api/gpus and /api/catalog.
AISIMULATORS_GATEWAY_URL=https://aisimulators.dev
AISIMULATORS_TIMEOUT_SECONDS=90

# aicostings API gateway — used by the app/api/costings/ proxy routes
# (server-side). Powers the costings features (model pricing, GPU cloud rates,
# hardware costs) behind the costingsEnabled setting.
AICOSTINGS_GATEWAY_URL=https://aicostings.dev
AICOSTINGS_TIMEOUT_SECONDS=30

# Private InferenceX comparison snapshot (server-side read token).
# Optional: without it the Compare page reports InferenceX as unavailable.
INFERENCEX_HF_TOKEN=

# In-app help assistant (server-side). Optional: search, tours, and docs work
# without it. All three must be set for the question box to appear.
# ASSISTANT_ENABLED=true
# ASSISTANT_MODEL=<model id served by the endpoint below>
# TRITON_INFERENCE_URL=http://host.containers.internal:8000

# Add future env vars here as features are added:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/gpu_calc
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
