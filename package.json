{
  "name": "configiq",
  "version": "0.2.5",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/inject-build-metadata.js && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/winston-transport": "^0.32.0",
    "@patternfly/react-charts": "^8.6.1",
    "@patternfly/react-core": "^6.6.2",
    "@patternfly/react-icons": "^6.6.1",
    "@patternfly/react-table": "^6.6.1",
    "next": "^16.3.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "victory": "^37.3.6",
    "winston-transport": "^4.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.18"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.11.1": true
  }
}
