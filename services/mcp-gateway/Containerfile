# Build context is the repository root, so the image can pull in the shared
# configiq-py package alongside this service and the repository LICENSE:
#
#   podman build -f services/mcp-gateway/Containerfile -t configiq-mcp .

FROM python:3.12-slim

LABEL org.opencontainers.image.source=https://github.com/redhat-performance/configiq
LABEL org.opencontainers.image.licenses=Apache-2.0

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/venv/bin:${PATH}

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip

COPY services/configiq-py /src/configiq-py
RUN /opt/venv/bin/pip install --no-cache-dir "/src/configiq-py[otel,mcp]"

COPY services/mcp-gateway/pyproject.toml /tmp/pyproject.toml
COPY services/scripts/install-deps.py /tmp/install-deps.py
RUN /opt/venv/bin/python /tmp/install-deps.py /tmp/pyproject.toml

COPY services/mcp-gateway /app

# The Apache 2.0 text travels with every published image.
COPY LICENSE /licenses/LICENSE

RUN chown -R 1001:0 /app /opt/venv \
    && chmod -R g=u /app /opt/venv

USER 1001

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD /opt/venv/bin/python -c "import urllib.request; urllib.request.urlopen('http://localhost:8090/health', timeout=5)" || exit 1

CMD ["uvicorn", "api_service.app:app", "--host", "0.0.0.0", "--port", "8090", "--workers", "1"]
