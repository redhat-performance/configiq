# AISimulators REST API service.
#
# Build context is services/ (not this directory) so the image can pull in the
# shared configiq-py package alongside this service. Build from the repo root:
#
#   podman build -f services/aisimulators/Containerfile -t aisimulators services/
#
# The image carries two simulators:
#
#   * the aisimulate SDK, installed from the single published wheel pinned in
#     pyproject.toml (bump it there to move to a newer SDK), and
#   * BLIS, built from source at the commit pinned below. BLIS is CPU-only and
#     fetches nothing at run time. A request's scenario is generated per call, so
#     no scenario directory is bundled.
#
# BLIS normally comes from its published release image, and this stage returns to
# one (`ghcr.io/inference-sim/blis:vX.Y.Z@sha256:...`) once a release carries the
# commands this service reads. Until then it builds the binary from the pushed
# head of the companion branch, so the image carries the artifact the API contract
# in this tree describes rather than one that predates it. See
# services/aisimulators/README.md for the commands and their releases.
#
# BLIS embeds its catalog, coefficient registry, and engine facts in the binary
# and reports them with its own commands. The API reads them from that same
# binary, so the image carries no data directory and cannot pair a binary with a
# different build's catalog. See services/aisimulators/README.md.

# --- BLIS build -------------------------------------------------------------------
# TEMPORARY: built from inference-sim's deploy/api branch at the commit pinned
# below (upstream main plus the four companion changes this service needs),
# tagged deploy-api-20261127-694802f5 in natoscott/inference-sim so a rewrite of
# the branch cannot orphan it:
#   https://github.com/inference-sim/inference-sim/pull/2693  (blis version --json)
#   https://github.com/inference-sim/inference-sim/pull/2694  (pool memory in the Result)
#   https://github.com/inference-sim/inference-sim/pull/2695  (blis catalog list)
#   https://github.com/inference-sim/inference-sim/pull/2696  (chip board power)
# Pin the commit, not the branch name, so the image cannot drift. Replace this
# stage with the release image once those land in a tagged release.
ARG BLIS_REPOSITORY=https://github.com/natoscott/inference-sim.git
ARG BLIS_COMMIT=694802f59d852c3f1c4dfdac5dd2bd0249618642
# The highest release the pinned commit descends from. The toolchain derives a
# commit's pseudo-version by describing it against the nearest tag, so the fetch
# has to reach back to that tag: a depth-1 checkout carries none, and `blis
# version` would report v0.0.0-... instead of the version this image states.
# It has to be the *highest* such tag: naming an older release does not merely
# lose precision, it claims a pre-release of a release the build already
# contains, so the reported version sorts below code that is newer than it.
ARG BLIS_BASE_TAG=v0.19.1
ARG BLIS_FETCH_DEPTH=25
# The Go version is inferred-sim's own: it is the `go` directive this commit
# states, and a build with another toolchain is not the artifact the pin names.
ARG BLIS_GO_VERSION=1.27.2
FROM golang:${BLIS_GO_VERSION}-alpine AS blis_build
ARG BLIS_REPOSITORY
ARG BLIS_COMMIT
ARG BLIS_BASE_TAG
ARG BLIS_FETCH_DEPTH
# Buildx injects these per platform in a multi-arch build.
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN apk add --no-cache git \
    && git init /src \
    && git -C /src remote add origin "${BLIS_REPOSITORY}" \
    && git -C /src fetch --depth "${BLIS_FETCH_DEPTH}" origin \
        "${BLIS_COMMIT}" "+refs/tags/${BLIS_BASE_TAG}:refs/tags/${BLIS_BASE_TAG}" \
    && git -C /src checkout --quiet --detach FETCH_HEAD
WORKDIR /src
# CGO_ENABLED=0 makes the binary static, as the release image's is, so it runs in
# this image without the Go toolchain or a libc it was not built against.
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
        go build -trimpath -ldflags="-s -w" -o /opt/blis/blis .

# --- llm-d deployment target ------------------------------------------------------
# The llm-d overlay the deployment service renders references files in the llm-d
# repository by relative path, so the bundle has to carry them. Vendor exactly
# the pinned revision through the same script CI uses, which keeps the path list
# and the revision in one place instead of duplicating them here.
FROM alpine/git:2.47.2 AS llm_d
ARG LLM_D_REVISION=378b42d18dabe0b9c4ced4e6f3670d93b52db08e
RUN apk add --no-cache bash
COPY aisimulators/scripts/fetch-llm-d-vendor.sh /tmp/fetch-llm-d-vendor.sh
RUN AISIMULATORS_LLM_D_VENDOR_DIR=/opt/llm-d bash /tmp/fetch-llm-d-vendor.sh "${LLM_D_REVISION}"

# The deployment render gate builds the overlay before the service returns it,
# so the image needs kustomize itself, not only the tree. Pin the release: the
# gate's verdict must not depend on whichever kustomize a base image happens to
# carry.
FROM alpine:3.22 AS kustomize
ARG KUSTOMIZE_VERSION=5.7.1
RUN apk add --no-cache curl tar \
    && curl -fsSL "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv${KUSTOMIZE_VERSION}/kustomize_v${KUSTOMIZE_VERSION}_linux_amd64.tar.gz" \
       | tar -xz -C /usr/local/bin kustomize \
    && /usr/local/bin/kustomize version

FROM python:3.12-slim

# The BLIS version reported by GET /simulators, GET /backends, and in every BLIS
# prediction's provenance: the Go pseudo-version `blis version` prints for the
# pinned commit, because no release tag contains it, with the `v` dropped as a
# release image's tag is. Keep in step with BLIS_COMMIT above.
ARG BLIS_VERSION=0.19.2-0.20261127005804-694802f59d85
# The commit the binary was built from, reported alongside BLIS_VERSION. The
# binary embeds no revision in that string, so the image states it; leave this
# empty for the default BLIS_VERSION and runtime.py resolves the pinned commit.
ARG BLIS_COMMIT=""

# Link the GHCR package to this repo (configiq), not the SDK-wheels fork whose
# name it shares. Set on package creation; add here so future publishes resolve
# to configiq/packages rather than redhat-performance/aisimulators.
LABEL org.opencontainers.image.source=https://github.com/redhat-performance/configiq

WORKDIR /app

# The build stage leaves the static binary at /opt/blis/blis; copy it into this
# image's layout, which runs as its own non-root user.
COPY --from=blis_build /opt/blis/blis /usr/local/bin/blis
COPY --from=llm_d /opt/llm-d /opt/llm-d
COPY --from=kustomize /usr/local/bin/kustomize /usr/local/bin/kustomize

# The build commit is reported as part of a replay record, so a recorded command
# names the exact build it was run against. It is identity, not configuration:
# nothing reads it to decide behaviour.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BLIS_VERSION=${BLIS_VERSION} \
    BLIS_COMMIT=${BLIS_COMMIT} \
    AISIMULATORS_LLM_D_VENDOR_DIR=/opt/llm-d \
    PATH=/opt/venv/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip

# Shared ConfigIQ library, with the observability + MCP extras so /metrics,
# tracing, and the MCP server light up in the deployed container.
COPY configiq-py /src/configiq-py
RUN /opt/venv/bin/pip install --no-cache-dir "/src/configiq-py[otel,mcp]"

# Runtime deps, read from pyproject.toml (single source of truth) by the shared
# installer — incl. the aisimulate SDK + its Rust-compiled core, which
# pyproject.toml references by exact fork-release wheel URL. Copy pyproject.toml
# alone first so this layer only rebuilds when the deps change. `python` here is
# the venv's (PATH=/opt/venv/bin), so pip installs into /opt/venv.
COPY scripts/install-deps.py aisimulators/pyproject.toml /tmp/
RUN python /tmp/install-deps.py /tmp/pyproject.toml

# Expose the aisimulate CLI at a stable system path, and fail the build early if
# either simulator binary cannot answer `--help` or if BLIS does not report the
# version this image states for it. The version is provenance, so the build
# proves it rather than restating it: `blis version` derives the pseudo-version
# from the pinned checkout, and the `+<revision>` suffix it appends is the
# commit BLIS_COMMIT names.
RUN ln -sf /opt/venv/bin/aisimulate /usr/local/bin/aisimulate \
    && /usr/local/bin/aisimulate --help >/dev/null \
    && /usr/local/bin/blis --help >/dev/null \
    && test "$(/usr/local/bin/blis version --json \
        | /opt/venv/bin/python -c 'import json, sys; print(json.load(sys.stdin)["inference_sim"].removeprefix("v").split("+")[0])')" \
        = "${BLIS_VERSION}"

# Thin REST wrapper. CMD imports it as api_service.app:app.
COPY aisimulators/tools/api_service /app/api_service

# The AISim SDK keeps its op-latency tables in a pinned Hugging Face dataset and
# composes its default systems root by downloading them on first use. Do that
# here, once, so a running container never depends on the Hub: the deployed
# hosts are rate-limited, and a cold cache would leave the API unhealthy on
# every restart. The composed root is what the process reads; the raw revision
# cache is only its input and would otherwise double the image size. Offline
# from here on, so a missing file fails the build rather than a deployment.
#
# The composed root's name ends in `_specs_fingerprint()`, a hash over the
# packaged spec files' paths, sizes, and mtimes. Pin those mtimes first: a
# restored build-cache layer can otherwise carry different ones than the layer
# that composed the root, leaving a shipped image whose name no longer matches,
# so offline compose ignores the root and fails on every container start.
ENV AISIM_DATA_CACHE=/app/.cache/aisim/data \
    AISIM_DATA_MAX_BYTES=4294967296
RUN python -c \
        "import os; from aisim_core.data.default_systems import PACKAGED_SYSTEMS_DIR; \
stamp = 1600000000; \
[os.utime(path, (stamp, stamp)) for path in PACKAGED_SYSTEMS_DIR.rglob('*') if path.is_file()]" \
    && python -c \
        "from aisim_core.data.default_systems import default_systems_path; print(default_systems_path())" \
    && test -d /app/.cache/aisim/data/systems \
    && find /app/.cache/aisim/data -mindepth 1 -maxdepth 1 ! -name systems -exec rm -rf {} +
ENV AISIM_DATA_OFFLINE=1

# OpenShift / rootless compatibility: numeric UID 1001, group 0 (root group),
# group-writable so an arbitrary assigned UID can still write.
RUN chown -R 1001:0 /app /opt/venv \
    && chmod -R g=u /app /opt/venv

# Resolve the composed root after every layer that can touch the venv, with the
# raw cache already pruned. A drifted fingerprint fails the build here instead
# of crash-looping every replica on the host.
RUN python -c \
        "from aisim_core.data.default_systems import default_systems_path; print(default_systems_path())"

USER 1001

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD /opt/venv/bin/python -c "import urllib.request; urllib.request.urlopen('http://localhost:7860/systems', timeout=5)" || exit 1

CMD ["uvicorn", "api_service.app:app", "--host", "0.0.0.0", "--port", "7860", "--workers", "2"]
