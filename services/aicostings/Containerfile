# AICostings FastAPI service — GPU and LLM pricing API.
#
# Build context is the repository root, so the image can pull in the shared
# configiq-py package alongside this service and the repository LICENSE. Build
# from the repo root:
#
#   podman build -f services/aicostings/Containerfile -t aicostings .
#
# Pure-Python service, but it sources the GPU system catalog + display names from
# the aisimulate SDK (via configiq.systems), so it installs those wheels too.

FROM registry.access.redhat.com/ubi9/python-311:latest

# Link the GHCR package to this repo (configiq) for the package UI + inherited access.
LABEL org.opencontainers.image.source=https://github.com/redhat-performance/configiq
LABEL org.opencontainers.image.licenses=Apache-2.0

# The UBI python image defaults to USER 1001 in /opt/app-root; run as root only
# for the install steps, then hand everything back to the arbitrary-UID user.
USER 0

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Shared ConfigIQ library, with the observability + MCP extras so /metrics,
# tracing, and the MCP server light up in the deployed container.
COPY services/configiq-py /src/configiq-py
RUN pip install --no-cache-dir "/src/configiq-py[otel,mcp]"

# Service runtime deps, read from pyproject.toml (single source of truth) by the
# shared installer. Copy pyproject.toml alone first so this layer only rebuilds
# when the deps change, not on every source edit. pyproject.toml references the
# aisimulate SDK wheels by exact fork-release URL — source of the GPU system
# catalog and vendor display names via configiq.systems, with pyarrow reading the
# SDK's bundled perf-data parquet.
COPY services/scripts/install-deps.py services/aicostings/pyproject.toml /tmp/
RUN python /tmp/install-deps.py /tmp/pyproject.toml

# Service source. The app reads bundled YAML from data/ and uses relative
# imports, so it runs from the source tree at /app (python -m tools.api_service.app).
COPY services/aicostings /app

# The AISim SDK keeps its op-latency tables in a pinned Hugging Face dataset and
# composes its default systems root by downloading them on first use. Do that
# here, once, so a running container never depends on the Hub: the deployed
# hosts are rate-limited, and a cold cache would leave the service unhealthy on
# every restart. Only the vendor display names are read here, but the dataset is
# the only place they live. The composed root is what the process reads; the raw
# revision cache is only its input and would otherwise double the image size.
# Offline from here on, so a missing file fails the build rather than a
# deployment.
#
# The composed root's name ends in `_specs_fingerprint()`, a hash over the
# packaged spec files' paths, sizes, and mtimes. Pin those mtimes first: a
# restored build-cache layer can otherwise carry different ones than the layer
# that composed the root, leaving a shipped image whose name no longer matches,
# so offline compose ignores the root and fails on every container start.
ENV AISIM_DATA_CACHE=/app/.cache/aisim/data \
    AISIM_DATA_MAX_BYTES=4294967296
RUN python -c \
        "import os; from aisim_core.data.default_systems import PACKAGED_SYSTEMS_DIR; \
stamp = 1600000000; \
[os.utime(path, (stamp, stamp)) for path in PACKAGED_SYSTEMS_DIR.rglob('*') if path.is_file()]" \
    && python -c \
        "from aisim_core.data.default_systems import default_systems_path; print(default_systems_path())" \
    && test -d /app/.cache/aisim/data/systems \
    && find /app/.cache/aisim/data -mindepth 1 -maxdepth 1 ! -name systems -exec rm -rf {} +
ENV AISIM_DATA_OFFLINE=1

# OpenShift / rootless compatibility: numeric UID 1001, group 0 (root group),
# group-writable so an arbitrary assigned UID can still write.
RUN chown -R 1001:0 /app \
    && chmod -R g=u /app

# Resolve the composed root after every layer that can touch the install, with
# the raw cache already pruned. A drifted fingerprint fails the build here
# instead of crash-looping every replica on the host.
RUN python -c \
        "from aisim_core.data.default_systems import default_systems_path; print(default_systems_path())"

# The Apache 2.0 text travels with every published image, as the last layer so a
# license change never invalidates the install or the dataset pre-warm.
COPY LICENSE /licenses/LICENSE

USER 1001

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health', timeout=5)" || exit 1

CMD ["python", "-m", "tools.api_service.app"]
