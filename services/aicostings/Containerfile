# AICostings FastAPI service — GPU and LLM pricing API.
#
# Build context is services/ (not this directory) so the image can pull in the
# shared configiq-py package alongside this service. Build from the repo root:
#
#   podman build -f services/aicostings/Containerfile -t aicostings services/
#
# Pure-Python service, but it sources the GPU system catalog + display names from
# the aisimulate SDK (via configiq.systems), so it installs those wheels too.

FROM registry.access.redhat.com/ubi9/python-311:latest

# Link the GHCR package to this repo (configiq) for the package UI + inherited access.
LABEL org.opencontainers.image.source=https://github.com/redhat-performance/configiq

# The UBI python image defaults to USER 1001 in /opt/app-root; run as root only
# for the install steps, then hand everything back to the arbitrary-UID user.
USER 0

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Shared ConfigIQ library, with the observability + MCP extras so /metrics,
# tracing, and the MCP server light up in the deployed container.
COPY configiq-py /src/configiq-py
RUN pip install --no-cache-dir "/src/configiq-py[otel,mcp]"

# Service runtime deps, read from pyproject.toml (single source of truth) by the
# shared installer. Copy pyproject.toml alone first so this layer only rebuilds
# when the deps change, not on every source edit. pyproject.toml references the
# aisimulate SDK wheels by exact fork-release URL — source of the GPU system
# catalog and vendor display names via configiq.systems, with pyarrow reading the
# SDK's bundled perf-data parquet.
COPY scripts/install-deps.py aicostings/pyproject.toml /tmp/
RUN python /tmp/install-deps.py /tmp/pyproject.toml

# Service source. The app reads bundled YAML from data/ and uses relative
# imports, so it runs from the source tree at /app (python -m tools.api_service.app).
COPY aicostings /app

# OpenShift / rootless compatibility: numeric UID 1001, group 0 (root group),
# group-writable so an arbitrary assigned UID can still write.
RUN chown -R 1001:0 /app \
    && chmod -R g=u /app

USER 1001

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health', timeout=5)" || exit 1

CMD ["python", "-m", "tools.api_service.app"]
